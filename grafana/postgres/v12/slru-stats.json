          "rawQuery": true,
          "rawSql": "SELECT\n  tag_data->>'name' as \"name\",\n  (data->>'blks_zeroed')::float8 \"blks_zeroed\",\n  (data->>'blks_hit')::float8 \"blks_hit\",\n  (data->>'blks_read')::float8 \"blks_read\",\n  (data->>'blks_written')::float8 \"blks_written\",\n  (data->>'blks_exists')::float8 \"blks_exists\",\n  (data->>'flushes')::float8 \"flushes\",\n  (data->>'truncates')::float8 \"truncates\"\nFROM\n  stat_slru \nWHERE\n  time = (select max(time) from stat_slru WHERE $__timeFilter(time) AND dbname = '$dbname')\n  AND dbname = '$dbname'\nORDER BY 1 DESC\n",
