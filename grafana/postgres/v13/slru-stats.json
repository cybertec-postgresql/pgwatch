    "cursorSync": "Off",
    "description": "pg_stat_slru / Simple Least Recently Used cache utilization.  High blocks read / written counts may hint at too small pertinent buffers - changing e.g. \"multixact_offset_buffers\" needs restart though",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "pgwatch-metrics"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "pgwatch_metrics",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  $__timeGroup(time, $agg_interval),\n  sum(blks_read - blks_read_lag) as blks_read,\n  sum(blks_written - blks_written_lag) as blks_written,\n  sum(flushes - flushes_lag) as flushes,\n  sum(truncates - truncates_lag) as truncates\nFROM (\n  SELECT\n    time,\n    tag_data->>'name' as name,\n    (data->>'blks_read')::float8 as blks_read,\n    lag((data->>'blks_read')::float8) over w as blks_read_lag,\n    (data->>'blks_written')::float8 as blks_written,\n    lag((data->>'blks_written')::float8) over w as blks_written_lag,\n    (data->>'flushes')::float8 as flushes,\n    lag((data->>'flushes')::float8) over w as flushes_lag,\n    (data->>'truncates')::float8 as truncates,\n    lag((data->>'truncates')::float8) over w as truncates_lag    \n  FROM \n    stat_slru\n  WHERE\n    $__timeFilter(time)\n    AND dbname = '$dbname'\n    AND tag_data @> jsonb_build_object('name', '$slru_name')\n  WINDOW w AS (order by time)\n) x\nWHERE blks_read >= blks_read_lag\nGROUP BY 1\nORDER BY 1\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "SLRU: $slru_name",
