          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "IntervalVariable",
        "spec": {
          "name": "agg_interval",
          "query": "1m,5m,10m,15m,30m,1h,6h,12h,1d",
          "current": {
