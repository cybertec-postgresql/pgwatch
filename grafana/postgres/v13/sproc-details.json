          "query": {
            "kind": "DataQuery",
            "group": "grafana-postgresql-datasource",
            "version": "v0",
            "datasource": {
              "name": "pgwatch-metrics"
            },
            "spec": {
              "__legacyStringValue": "SELECT DISTINCT dbname FROM admin.all_distinct_dbname_metrics WHERE metric = 'sproc_stats' ORDER BY 1;"
            }
          },
          "regex": "",
