          "title": "Avg wait time per acquisition (ms)",
          "description": "Average milliseconds waited per successful lock acquisition: `sum(wait_time_ms) / nullif(sum(waits), 0)`.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
