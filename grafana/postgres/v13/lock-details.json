      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Top lock-type share of waits",
          "description": "Share of total cumulative waits contributed by each lock type over the selected range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-metrics"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "group": [],
                        "metricColumn": "time",
                        "rawQuery": true,
                        "rawSql": "SELECT now() AS time,\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='advisory' THEN (data->>'waits')::bigint ELSE 0 END) AS \"advisory\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='applytransaction' THEN (data->>'waits')::bigint ELSE 0 END) AS \"applytransaction\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='extend' THEN (data->>'waits')::bigint ELSE 0 END) AS \"extend\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='frozenid' THEN (data->>'waits')::bigint ELSE 0 END) AS \"frozenid\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='object' THEN (data->>'waits')::bigint ELSE 0 END) AS \"object\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='page' THEN (data->>'waits')::bigint ELSE 0 END) AS \"page\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='relation' THEN (data->>'waits')::bigint ELSE 0 END) AS \"relation\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='spectoken' THEN (data->>'waits')::bigint ELSE 0 END) AS \"spectoken\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='transactionid' THEN (data->>'waits')::bigint ELSE 0 END) AS \"transactionid\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='tuple' THEN (data->>'waits')::bigint ELSE 0 END) AS \"tuple\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='userlock' THEN (data->>'waits')::bigint ELSE 0 END) AS \"userlock\",\n       SUM(CASE WHEN COALESCE(tag_data->>'locktype','unknown')='virtualxid' THEN (data->>'waits')::bigint ELSE 0 END) AS \"virtualxid\"\n  FROM stat_lock\n WHERE dbname IN ($dbname) AND $__timeFilter(time)\n",
                        "select": [
                          [
                            {
                              "params": [
