      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Lock waits/sec by type (PG19+)",
          "description": "Rate of lock waits per second, grouped by `pg_stat_lock.locktype`. Sourced from the `stat_lock` metric (PostgreSQL 19+).",
          "links": [
            {
              "title": "Back to Global Overview",
              "url": "/d/1-global-database-overview?$__all_variables",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-metrics"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "group": [],
                        "metricColumn": "none",
                        "rawQuery": true,
                        "rawSql": "SELECT to_timestamp($__timeGroup(time, $agg_interval)) AS time,\n       COALESCE(tag_data->>'locktype', 'unknown') AS metric,\n       (max((data->>'waits')::bigint) - lag(max((data->>'waits')::bigint)) OVER (PARTITION BY COALESCE(tag_data->>'locktype', 'unknown') ORDER BY to_timestamp($__timeGroup(time, $agg_interval)))) / NULLIF(extract(epoch FROM (to_timestamp($__timeGroup(time, $agg_interval)) - lag(to_timestamp($__timeGroup(time, $agg_interval))) OVER (PARTITION BY COALESCE(tag_data->>'locktype', 'unknown') ORDER BY to_timestamp($__timeGroup(time, $agg_interval))))), 0) AS value\n  FROM stat_lock\n WHERE dbname IN ($dbname) AND $__timeFilter(time)\n GROUP BY 1, 2\n ORDER BY 1",
                        "select": [
                          [
                            {
                              "params": [
                                "value"
                              ],
                              "type": "column"
                            }
                          ]
                        ],
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "timeColumn": "time",
                        "where": [
                          {
                            "name": "$__timeFilter",
                            "params": [],
                            "type": "macro"
                          }
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "ConvertFieldType",
                  "spec": {
                    "fields": {},
                    "conversions": [
                      {
                        "targetField": "Time",
                        "targetType": "time",
                        "destinationType": "time"
                      }
                    ],
                    "timeField": "Time"
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.2",
            "spec": {
              "options": {
                "annotations": {
                  "clustering": -1,
