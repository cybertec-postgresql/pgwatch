                            "key": "dbname",
                            "operator": "=~",
                            "value": "/^$dbname$/"
                          }
                        ],
                        "timeColumn": "time",
                        "where": [
                          {
                            "name": "$__timeFilter",
                            "params": [],
                            "type": "macro"
                          }
                        ]
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
