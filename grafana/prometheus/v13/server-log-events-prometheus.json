            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "topk(20, sum by (dbname) (increase(pgwatch_server_log_event_counts_error{dbname=~\"$dbname\"}[$__range])))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "ERROR"
                      }
