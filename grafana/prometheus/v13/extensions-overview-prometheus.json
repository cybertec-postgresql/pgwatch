{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "extensions-overview-prometheus"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Outdated extensions",
          "description": "Installed extensions whose version differs from the default version the server offers. An ALTER EXTENSION ... UPDATE is available for them.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max by (dbname, extension) (last_over_time(pgwatch_extensions_update_available{dbname=~\"$dbname\"}[3h]))) or vector(0)",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "12.0.0",
            "spec": {
              "options": {
                "colorMode": "background_solid",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "textMode": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "#28781e"
                      },
                      {
                        "value": 1,
                        "color": "rgba(237, 129, 40, 0.89)"
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A"
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Installed extensions",
          "description": "Latest reported extension versions per source. Amber means the installed version is behind the default version of the server.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (dbname, extension, installed_version, default_version) (last_over_time(pgwatch_extensions_update_available{dbname=~\"$dbname\"}[3h]))",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {
                      "reducers": []
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true,
                        "job": true,
                        "instance": true
                      },
                      "includeByName": {},
                      "indexByName": {
                        "dbname": 0,
                        "extension": 1,
                        "installed_version": 2,
                        "default_version": 3,
                        "Value": 4
                      },
                      "renameByName": {
                        "Value": "outdated"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "12.0.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "fields": "",
                  "countRows": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "#28781e"
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "dbname"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Source Name"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "extension"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Extension"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "default_version"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Default version"
                      },
                      {
                        "id": "description",
                        "value": "Version the server offers in pg_available_extensions."
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "installed_version"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Installed version"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "outdated"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Update available"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": 0,
                              "color": "#28781e"
                            },
                            {
                              "value": 1,
                              "color": "rgba(237, 129, 40, 0.89)"
                            }
                          ]
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "No",
                                "index": 0
                              },
                              "1": {
                                "text": "Yes",
                                "index": 1
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-colophon": {
        "kind": "Panel",
        "spec": {
          "id": 99999,
          "title": "",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "12.0.0",
            "spec": {
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "### Brought to you by\n\n<a href=\"https://www.cybertec-postgresql.com/en/\"><img src=\"https://cdn.jsdelivr.net/gh/cybertec-postgresql/pgwatch@master/docs/gallery/cybertec-logo-white-blue.svg\" alt=\"Cybertec – The PostgreSQL Database Company\" width=\"300\" /></a>\n",
                "mode": "markdown"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Extensions",
              "collapse": false,
              "hideHeader": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 4,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 6,
                        "width": 24,
                        "height": 14,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "hideHeader": true,
              "title": "Colophon",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "narrow",
                  "fillScreen": true,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-colophon"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 1,
                  "rowHeightMode": "standard"
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "pgwatch",
      "prometheus"
    ],
    "timeSettings": {
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Extensions Overview",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "dbname",
          "current": {
            "text": "All",
            "value": [
              "$__all"
            ]
          },
          "label": "Source Name",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "pgwatch-prometheus"
            },
            "spec": {
              "query": "label_values(pgwatch_extensions_update_available, dbname)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "sort": "disabled",
          "definition": "label_values(pgwatch_extensions_update_available, dbname)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ]
  }
}