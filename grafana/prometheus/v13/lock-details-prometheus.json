{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "lock-details-prometheus"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "labels": {
              "grafana.app/export-label": "grafana-1"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Lock waits/sec by type (PG19+)",
          "description": "Rate of lock waits per second, grouped by `pg_stat_lock.locktype`. Sourced from the `stat_lock` metric (PostgreSQL 19+) emitted by pgwatch as `pgwatch_stat_lock_waits`.",
          "links": [
            {
              "title": "Back to Global Overview",
              "url": "/d/1-global-db-overview-prometheus?$__all_variables",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "sum by (locktype) (rate(pgwatch_stat_lock_waits{dbname=~\"$dbname\"}[$__range]))",
                        "legendFormat": "{{locktype}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.3.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "sortBy": "Max",
                  "sortDesc": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 10,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "axisPlacement": "auto",
                    "axisLabel": "waits/s",
                    "scaleDistribution": {
                      "type": "linear"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#28781e"
                      },
                      {
                        "value": 10,
                        "color": "rgba(237, 129, 40, 0.89)"
                      },
                      {
                        "value": 100,
                        "color": "#d44a3a"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Avg wait time per acquisition (ms)",
          "description": "Average wait time in milliseconds per lock acquisition since stats reset. Gauge field `pgwatch_stat_lock_wait_time_ms` over the lifetime counter `pgwatch_stat_lock_waits`.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "sum(pgwatch_stat_lock_wait_time_ms{dbname=~\"$dbname\"}) / clamp_min(sum(pgwatch_stat_lock_waits{dbname=~\"$dbname\"}), 1)",
                        "legendFormat": "avg wait"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 1
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "12.3.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {},
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "decimals": 2,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#28781e"
                      },
                      {
                        "value": 50,
                        "color": "rgba(237, 129, 40, 0.89)"
                      },
                      {
                        "value": 200,
                        "color": "#d44a3a"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Fast-path lock pool exceeded (PG19+)",
          "description": "Rate of total wait time accumulating per second across all lock types.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(pgwatch_stat_lock_wait_time_ms{dbname=~\"$dbname\"}[$__range]))",
                        "legendFormat": "total wait"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.3.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "sortBy": "Max",
                  "sortDesc": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "min": 0,
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 15,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "axisPlacement": "auto",
                    "axisLabel": "ms/s",
                    "scaleDistribution": {
                      "type": "linear"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Cumulative lock waits by type",
          "description": "Running total of `pgwatch_stat_lock_waits` across all lock types since process start.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "sum(pgwatch_stat_lock_waits{dbname=~\"$dbname\"})",
                        "legendFormat": "cumulative waits"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.3.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "sortBy": "Max",
                  "sortDesc": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "stepAfter",
                    "lineWidth": 1,
                    "fillOpacity": 5,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "axisPlacement": "auto",
                    "axisLabel": "waits",
                    "scaleDistribution": {
                      "type": "linear"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Total lock wait time (ms/sec)",
          "description": "Rate of fast-path lock acquisition failures that fell back to the regular lock manager.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "sum by (locktype) (rate(pgwatch_stat_lock_fastpath_exceeded{dbname=~\"$dbname\"}[$__range]))",
                        "legendFormat": "{{locktype}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "12.3.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "sortBy": "Max",
                  "sortDesc": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "fillOpacity": 15,
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "axisPlacement": "auto",
                    "axisLabel": "exceeded/s",
                    "scaleDistribution": {
                      "type": "linear"
                    }
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#28781e"
                      },
                      {
                        "value": 5,
                        "color": "rgba(237, 129, 40, 0.89)"
                      },
                      {
                        "value": 50,
                        "color": "#d44a3a"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Time since pg_stat_lock reset",
          "description": "Time elapsed since `pg_stat_lock` counters were last reset (seconds). Gauge field `pgwatch_stat_lock_stats_reset_s`.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "max(pgwatch_stat_lock_stats_reset_s{dbname=~\"$dbname\"})",
                        "legendFormat": "reset age",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "12.3.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {},
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "decimals": 0,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#28781e"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Top lock-type share of waits",
          "description": "Share of total waits contributed by each locktype since stats reset. Pie / donut visualization.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "pgwatch-prometheus"
                      },
                      "spec": {
                        "expr": "topk(5, sum by (locktype) (pgwatch_stat_lock_waits{dbname=~\"$dbname\"}))",
                        "legendFormat": "{{locktype}}",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "12.3.1",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "pieType": "donut",
                "displayLabels": [
                  "name",
                  "percent"
                ],
                "legend": {
                  "displayMode": "list",
                  "placement": "right",
                  "showLegend": true,
                  "values": [
                    "value"
                  ]
                },
                "tooltip": {
                  "mode": "single"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#28781e"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Locks (PG19+)",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 16,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 16,
                        "y": 0,
                        "width": 8,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 16,
                        "y": 6,
                        "width": 8,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-6"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-4"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-5"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 20,
                        "width": 16,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 16,
                        "y": 20,
                        "width": 8,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-7"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "pgwatch",
      "prometheus"
    ],
    "timeSettings": {
      "timezone": "utc",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Lock details (PG19+)",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "dbname",
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "spec": {
              "__legacyStringValue": "label_values(pgwatch_instance_up, dbname)"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "label_values(pgwatch_instance_up, dbname)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "agg_interval",
          "query": "10s,1m,5m,1h",
          "current": {
            "text": "1m",
            "value": "1m"
          },
          "options": [
            {
              "selected": false,
              "text": "10s",
              "value": "10s"
            },
            {
              "selected": true,
              "text": "1m",
              "value": "1m"
            },
            {
              "selected": false,
              "text": "5m",
              "value": "5m"
            },
            {
              "selected": false,
              "text": "1h",
              "value": "1h"
            }
          ],
          "multi": false,
          "includeAll": false,
          "label": "Aggregation interval",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "locktype",
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "spec": {
              "__legacyStringValue": "label_values(pgwatch_stat_lock_waits, locktype)"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "label_values(pgwatch_stat_lock_waits, locktype)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ]
  }
}
