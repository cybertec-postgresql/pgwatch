      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Disk I/O Throughput",
          "description": "Disk I/O operations and bytes transferred",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
